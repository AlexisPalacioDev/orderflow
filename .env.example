# PostgreSQL
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_ORDERS_DB=orders
POSTGRES_INVENTORY_DB=inventory

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=orderflow

# Host ports
WEB_PORT=8080
API_PORT=5080
RABBIT_UI_PORT=15672

# Worker / Outbox tuning
OUTBOX_POLL_MS=1000
RETRY_DELAY_MS=5000
MAX_DELIVERY_ATTEMPTS=5
